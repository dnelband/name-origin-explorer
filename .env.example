# Copied from the Vercel ↔ Supabase integration (Project → Settings → Environment Variables).
# Local: paste the same set into .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=

POSTGRES_DATABASE=postgres
POSTGRES_HOST=db.your-project.supabase.co
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Runtime (transaction pooler) — used by the Next.js app
POSTGRES_URL=postgres://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_PRISMA_URL=postgres://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# Migrations / drizzle-kit — direct connection (non-pooling)
POSTGRES_URL_NON_POOLING=postgres://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
